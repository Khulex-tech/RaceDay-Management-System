@model RegisterForm
@{
    ViewData["Title"] = "Register";
}
<div class="page-head">
    <div>
        <h1>Create an account</h1>
        <p class="muted">Participants can register immediately. Organisers need the invite code configured on the API.</p>
    </div>
</div>
<form method="post" class="form-card" novalidate>
    <div asp-validation-summary="ModelOnly" class="banner banner-error" role="alert"></div>
    <div class="form-grid">
        <div>
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="field-error"></span>
        </div>
        <div>
            <label asp-for="LastName"></label>
            <input asp-for="LastName" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="field-error"></span>
        </div>
        <div>
            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div>
            <label asp-for="PhoneNumber"></label>
            <input asp-for="PhoneNumber" autocomplete="tel" />
            <span asp-validation-for="PhoneNumber" class="field-error"></span>
        </div>
        <div>
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div>
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
    </div>
    <fieldset style="border:0;padding:0;margin:1rem 0;">
        <legend style="font-weight:700;">I am joining as</legend>
        <label><input type="radio" asp-for="Role" value="Participant" /> Participant</label>
        <label><input type="radio" asp-for="Role" value="Organiser" /> Organiser</label>
        <span asp-validation-for="Role" class="field-error"></span>
    </fieldset>
    <div>
        <label asp-for="InviteCode"></label>
        <input asp-for="InviteCode" autocomplete="off" />
        <span asp-validation-for="InviteCode" class="field-error"></span>
        <p class="muted">Leave this blank unless you are registering an organiser account.</p>
    </div>
    <div class="actions">
        <button class="btn" type="submit">Register</button>
        <a href="/Account/Login">I already have an account</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
