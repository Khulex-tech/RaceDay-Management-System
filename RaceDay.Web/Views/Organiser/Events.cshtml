@model List<OrganiserEventItem>
@{
    ViewData["Title"] = "Manage events";
}
<div class="page-head">
    <div>
        <h1>Manage events</h1>
        <p class="muted">Only events you created are listed here.</p>
    </div>
    <a class="btn" href="/organiser/events/create">Create event</a>
</div>
@if (Model.Count == 0)
{
    <section class="empty-state">
        <h2>No events yet</h2>
        <p class="muted">Create a run, walk or cycle event and then add categories.</p>
    </section>
}
else
{
    <div class="panel">
        <div class="table-wrap">
            <table>
                <caption>Your events</caption>
                <thead>
                    <tr>
                        <th scope="col">Event</th>
                        <th scope="col">Date</th>
                        <th scope="col">Distance</th>
                        <th scope="col">Enrolments</th>
                        <th scope="col">Manage</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>@item.EventDate.ToString("d MMM yyyy")</td>
                            <td>@item.DistanceKm.ToString("0.##") km</td>
                            <td>@item.EnrolmentCount</td>
                            <td class="actions">
                                <a href="/organiser/events/@item.EventId/edit">Edit</a>
                                <a href="/organiser/events/@item.EventId/categories">Categories</a>
                                <a href="/organiser/events/@item.EventId/enrolments">Entries</a>
                                <a href="/organiser/events/@item.EventId/results">Results</a>
                                <form method="post" action="/organiser/events/@item.EventId/delete" class="inline-form">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-danger" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
