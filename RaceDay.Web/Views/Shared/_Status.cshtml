@model string
@{
    string css = (Model ?? string.Empty).ToLowerInvariant() switch
    {
        "confirmed" => "status-confirmed",
        "cancelled" => "status-cancelled",
        _ => "status-pending"
    };
}
<span class="status-pill @css">@(string.IsNullOrWhiteSpace(Model) ? "Unknown" : Model)</span>
